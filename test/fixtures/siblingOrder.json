{
  "id": "siblingOrder",
  "let": {
    "order": { "op": "coalesce", "args": [{ "key": "options.order" }, { "key": "options.by" }] },
    "group": { "op": "orderedGroup", "args": ["$node"] }
  },
  "when": { "op": "isFirstMatchingInGroup", "args": ["$node", "$group", "$order"] },
  "not": { "op": "inOrder", "args": ["$group", "$order"] },
  "report": { "at": "$node", "downgradeWhen": { "op": "orderUnreliable", "args": ["$node"] } }
}
